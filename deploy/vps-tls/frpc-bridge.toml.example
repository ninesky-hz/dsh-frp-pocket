# 本机桥接客户端：把 frps 在 443 上收到的 TLS 字节按 SNI 交给本机 Caddy(9443)。
#
# 关键点：这是「同一台机器上的 frpc」，不是家里的那台。
#   frps(443) --type=https, customDomains=['dsh.example.com']--> 本机 Caddy
# 其他域名（example.com / example.com / example.com …）的 SNI 匹配不到这条规则，
# 仍由 frps 直接透传给各自的客户端 —— 因此不需要改动 frps.toml 一行。
#
# 真实文件由 deploy/vps-tls/install.sh 生成到 /opt/frp-bridge/frpc-bridge.toml，
# 其中 auth.token 取自 frps.toml 的 auth.token（两边必须一致）。

serverAddr = "127.0.0.1"
serverPort = 7000
loginFailExit = false

log.to = "/var/log/frp-bridge.log"
log.level = "info"
log.maxDays = 3

auth.method = "token"
auth.token = "__FRP_TOKEN__"        # 同 frps.toml 的 auth.token

[[proxies]]
name = "dsh-pocket-tls"
type = "https"
localIP = "127.0.0.1"
localPort = 9443                   # Caddy 的 https_port
customDomains = ["dsh.example.com"]  # 与 Caddyfile 里 import dsh_site 的域名保持一致
